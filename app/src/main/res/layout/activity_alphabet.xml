<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".AlphabetActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alfabeto LSM"
                android:textColor="@color/text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Estado: sin conexión"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLastCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:text="Selecciona una letra para enviar una señal al guante."
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <GridLayout
                android:id="@+id/gridAlphabet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <Button
                android:id="@+id/btnRest"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_button_primary"
                android:text="Posición de reposo"
                android:textAllCaps="false"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnBackConnection"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Volver a conexión"
                android:textAllCaps="false"
                android:textColor="@color/brand" />

            <Button
                android:id="@+id/btnDisconnectFromAlphabet"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Desconectar guante"
                android:textAllCaps="false"
                android:textColor="@color/brand" />

        </LinearLayout>

    </ScrollView>

    <FrameLayout
        android:id="@+id/letterPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_card"
            android:elevation="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreviewLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Letra A"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivLetterSign"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="Posición de la mano"
                android:scaleType="fitCenter" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
