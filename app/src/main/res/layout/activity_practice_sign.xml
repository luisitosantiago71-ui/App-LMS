<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.mechrobotix.aprendels.HandOverlayView
        android:id="@+id/overlayCanvasView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.mechrobotix.aprendels.MotionHandOverlayView
        android:id="@+id/motionOverlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/motionDemoArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#CC101010"
        app:layout_constraintTop_toBottomOf="@id/guideControls"
        app:layout_constraintBottom_toTopOf="@id/tvMatchStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <VideoView
            android:id="@+id/motionDemo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Barra superior compacta y oscura -->
    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:background="#EE000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Haz la seña: A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@android:color/transparent"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <ProgressBar
            android:id="@+id/progressBarMatch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#42A5F5"
            android:progressBackgroundTint="#55FFFFFF" />

        <TextView
            android:id="@+id/tvMotionStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:background="#66000000"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="3dp" />
    </LinearLayout>

    <!-- Controles compactos junto a la referencia -->
    <LinearLayout
        android:id="@+id/guideControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#B8000000"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/referencePreview">

        <Button
            android:id="@+id/btnChooseLetter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textAllCaps="false"
            android:text="Elegir letra: A"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC202020"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnMirrorGuide"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textAllCaps="false"
            android:text="Modo espejo: no"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC202020"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnToggleGuideControls"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:textAllCaps="false"
            android:text="Ajustar guía"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC202020"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <!-- Menú desplegable oscuro para ajustar la silueta -->
        <ScrollView
            android:id="@+id/guideAdjustmentPanel"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:fillViewport="false"
            android:background="#E6151515"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ajuste de silueta"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/tvGuideSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ancho: 28%"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekGuideSize"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:max="45"
                    android:progress="13"
                    android:progressTint="#42A5F5"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:thumbTint="#90CAF9"
                    android:contentDescription="Ancho de la guía" />

                <TextView
                    android:id="@+id/tvGuideX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horizontal: 28%"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekGuideX"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:max="100"
                    android:progress="28"
                    android:progressTint="#42A5F5"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:thumbTint="#90CAF9"
                    android:contentDescription="Posición horizontal: izquierda a derecha" />

                <TextView
                    android:id="@+id/tvGuideY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vertical: 38%"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekGuideY"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:max="100"
                    android:progress="38"
                    android:progressTint="#42A5F5"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:thumbTint="#90CAF9"
                    android:contentDescription="Posición vertical: arriba a abajo" />

                <TextView
                    android:id="@+id/tvGuideRotation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rotación: 0°"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seekGuideRotation"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:max="360"
                    android:progress="180"
                    android:progressTint="#42A5F5"
                    android:progressBackgroundTint="#55FFFFFF"
                    android:thumbTint="#90CAF9"
                    android:contentDescription="Rotación entre menos 180 y 180 grados" />

                <TextView
                    android:id="@+id/tvGuideSaved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardado automático"
                    android:textSize="11sp"
                    android:textColor="#B9F6CA"
                    android:gravity="center"
                    android:paddingTop="2dp"
                    android:paddingBottom="6dp" />

                <Button
                    android:id="@+id/btnResetGuideControls"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:minHeight="0dp"
                    android:text="Restablecer esta letra"
                    android:textAllCaps="false"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#AA3A3A3A"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Referencia más angosta para dejar más espacio a la cámara -->
    <FrameLayout
        android:id="@+id/referencePreview"
        android:layout_width="100dp"
        android:layout_height="148dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="8dp"
        android:padding="4dp"
        android:background="#B8000000"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSignReference"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sign_a"
            android:contentDescription="Referencia de la letra A" />

        <VideoView
            android:id="@+id/videoSignReference"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/referenceTap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom|center_horizontal"
            android:paddingBottom="3dp"
            android:text="Ampliar"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Abrir referencia en pantalla completa" />
    </FrameLayout>

    <!-- Mensaje flotante inferior, sin tarjeta blanca -->
    <TextView
        android:id="@+id/tvMatchStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingTop="9dp"
        android:paddingEnd="12dp"
        android:paddingBottom="9dp"
        android:background="#B8000000"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:text="Preparando la guía…"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel" />

    <!-- Barra inferior oscura y compacta -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:background="#EE000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnBackFromPractice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Regresar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC202020"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnNextSign"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="0dp"
            android:enabled="false"
            android:text="Siguiente"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#CC303030"
            android:elevation="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
