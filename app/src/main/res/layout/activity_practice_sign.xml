<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <com.mechrobotix.aprendels.HandOverlayView
        android:id="@+id/overlayCanvasView"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/topPanel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/tvInstruction"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Haz la seña: A" android:textSize="22sp" android:textStyle="bold"
            android:textColor="@android:color/white" android:gravity="center"
            android:background="#B3000000" android:padding="8dp" />
        <ProgressBar android:id="@+id/progressBarMatch"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="10dp"
            android:layout_marginTop="8dp" android:max="100" android:progress="0" />
    </LinearLayout>

    <LinearLayout android:id="@+id/guideControls"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp" android:background="#B3000000"
        android:layout_marginStart="16dp" android:layout_marginEnd="8dp" android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/ivSignReference">
        <Button android:id="@+id/btnChooseLetter"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Elegir letra: A" android:textSize="12sp" />
        <Button android:id="@+id/btnMirrorGuide"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Espejo: desactivado" android:textSize="12sp" />
        <Button android:id="@+id/btnToggleGuideControls"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ajustar guía" android:textSize="12sp" />
        <ScrollView android:id="@+id/guideAdjustmentPanel"
            android:layout_width="match_parent" android:layout_height="240dp"
            android:visibility="gone" android:fillViewport="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView android:id="@+id/tvGuideSize"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Ancho: 28%" android:textColor="@android:color/white" />
                <SeekBar android:id="@+id/seekGuideSize"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:max="45" android:progress="13" android:contentDescription="Ancho de la guía" />
                <TextView android:id="@+id/tvGuideX"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Horizontal: 28%" android:textColor="@android:color/white" />
                <SeekBar android:id="@+id/seekGuideX"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:max="100" android:progress="28" android:contentDescription="Posición horizontal: izquierda a derecha" />
                <TextView android:id="@+id/tvGuideY"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Vertical: 38%" android:textColor="@android:color/white" />
                <SeekBar android:id="@+id/seekGuideY"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:max="100" android:progress="38" android:contentDescription="Posición vertical: arriba a abajo" />
                <TextView android:id="@+id/tvGuideRotation"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Rotación: 0°" android:textColor="@android:color/white" />
                <SeekBar android:id="@+id/seekGuideRotation"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:max="360" android:progress="180" android:contentDescription="Rotación entre menos 180 y 180 grados" />
                <TextView android:id="@+id/tvGuideSaved"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Guardado automático" android:textSize="12sp"
                    android:textColor="@android:color/white" />
                <Button android:id="@+id/btnResetGuideControls"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Restablecer esta letra" android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
        <Button android:id="@+id/btnReviewReference"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Revisar imágenes" android:textSize="12sp" />
        <Button android:id="@+id/btnPrepareJ"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Preparar y practicar J" android:textSize="12sp" />
        <Button android:id="@+id/btnMotionPractice"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Prueba anterior (experimental)" android:textSize="12sp" />
    </LinearLayout>

    <ImageView android:id="@+id/ivSignReference"
        android:layout_width="96dp" android:layout_height="120dp"
        android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
        android:background="@android:color/white" android:padding="4dp"
        android:scaleType="fitCenter" android:src="@drawable/sign_a"
        android:contentDescription="Referencia de la letra A"
        app:layout_constraintTop_toBottomOf="@id/topPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView android:id="@+id/tvMatchStatus"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:padding="10dp"
        android:background="#CC000000" android:textColor="@android:color/white"
        android:textSize="18sp" android:gravity="center"
        android:accessibilityLiveRegion="polite"
        android:text="Preparando la guía…"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel" />

    <LinearLayout android:id="@+id/bottomPanel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="16dp" android:background="#B3000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <Button android:id="@+id/btnBackFromPractice"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Regresar" />
        <Button android:id="@+id/btnNextSign"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            android:enabled="false" android:text="Siguiente" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
